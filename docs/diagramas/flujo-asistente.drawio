<mxfile host="CaptaBot" type="device"><diagram id="1366efa0-c9a9-581a-bf74-221e20ed1a45" name="Flujo del asistente"><mxGraphModel dx="1060" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Flujo de conversación del asistente de CaptaBot" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1060" height="30" as="geometry"/></mxCell><mxCell id="inicio" value="Inicio: el cliente abre el chat" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="55" width="180" height="50" as="geometry"/></mxCell><mxCell id="saludo" value="Saludo: «Puedo resolver tus dudas o ayudarte a cotizar»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="135" width="260" height="60" as="geometry"/></mxCell><mxCell id="que" value="¿Qué necesita el cliente?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="225" width="220" height="110" as="geometry"/></mxCell><mxCell id="faq" value="Responder pregunta frecuente (Azure AI Language o buscador local)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="230" height="70" as="geometry"/></mxCell><mxCell id="asesor" value="¿Quiere que un asesor lo contacte?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="360" width="220" height="110" as="geometry"/></mxCell><mxCell id="respaldo" value="Mensaje de respaldo: temas que puede atender" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="245" width="240" height="70" as="geometry"/></mxCell><mxCell id="consent" value="Pedir consentimiento para guardar sus datos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="385" width="260" height="60" as="geometry"/></mxCell><mxCell id="acepta" value="¿Acepta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="478" width="180" height="100" as="geometry"/></mxCell><mxCell id="nombre" value="Pedir nombre" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="220" height="46" as="geometry"/></mxCell><mxCell id="celular" value="Pedir celular de 9 dígitos (si no, lo vuelve a pedir)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="686" width="220" height="46" as="geometry"/></mxCell><mxCell id="servicio" value="Pedir servicio de interés" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="762" width="220" height="46" as="geometry"/></mxCell><mxCell id="presupuesto" value="Pedir presupuesto (S/)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="838" width="220" height="46" as="geometry"/></mxCell><mxCell id="urgencia" value="Pedir urgencia: Alta, Media o Baja" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="914" wi