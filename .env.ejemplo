# Copien este archivo como .env (en la misma carpeta) y completen los valores.
# Lo leen solos Docker Compose y la API (también al ejecutarla desde el IDE). El archivo .env no se sube a GitHub.

# Clave que pide la API al panel (opcional en local). Si la ponen y ejecutan el panel desde el IDE,
# copien la misma clave en panel/CaptaBot.Panel/appsettings.Development.json (CaptabotApi:ClaveApi).
CAPTABOT_API_KEY=

# Azure AI Language – custom question answering (plan gratuito F0). Ver asistente/README.md
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_PROYECTO=captabot-faq

# Canal de Telegram (opcional): token que entrega @BotFather. Ver asistente/README.md
TELEGRAM_BOT_TOKEN=

# Automatización (HU13). Código que los vendedores escriben al bot para recibir avisos: /vendedor <código>
TELEGRAM_CODIGO_VENTAS=
# Minutos que un prospecto caliente o tibio puede seguir en «Nuevo» antes de recordarlo al equipo
CAPTABOT_RECORDATORIO_MINUTOS=120
# Minutos después del registro en que el bot escribe al cliente que llegó por Telegram (1440 = 24 horas)
CAPTABOT_SEGUIMIENTO_MINUTOS=1440
