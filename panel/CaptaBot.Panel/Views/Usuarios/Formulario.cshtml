@model UsuarioFormulario
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo usuario" : "Editar usuario";
}
<p><a asp-action="Index" class="volver">← Volver a usuarios</a></p>

<section class="tarjeta formulario">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="@(Model.EsNuevo ? "Nuevo" : "Editar")" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="aviso aviso-error"></div>

        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" autocomplete="off" />
        <span asp-validation-for="Nombre" class="error-campo"></span>

        <label asp-for="Correo"></label>
        <input asp-for="Correo" type="email" autocomplete="off" />
        <span asp-validation-for="Correo" class="error-campo"></span>

        <label asp-for="Contrasena"></label>
        <input asp-for="Contrasena" autocomplete="new-password" />
        <span class="sutil">
            @(Model.EsNuevo ? "Mínimo 8 caracteres." : "Déjala en blanco para mantener la contraseña actual.")
        </span>
        <span asp-validation-for="Contrasena" class="error-campo"></span>

        <label for="Rol">Rol</label>
        <select id="Rol" name="Rol">
            @HtmlAyuda.Opciones(Etiquetas.Roles, Model.Rol)
        </select>
        <span asp-validation-for="Rol" class="error-campo"></span>

        <div class="botones">
            <button type="submit" class="boton">Guardar</button>
            <a asp-action="Index" class="boton boton-claro">Cancelar</a>
        </div>
    </form>
</section>
