@model IReadOnlyList<Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var miId = User.UsuarioId();
}
<div class="encabezado">
    <h1>Usuarios del panel</h1>
    <a asp-action="Nuevo" class="boton">Nuevo usuario</a>
</div>

<div class="tabla-contenedor tarjeta">
    <table class="tabla">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr class="@(u.Activo ? "" : "inactivo")">
                    <td>@u.Nombre @if (u.Id == miId) { <span class="sutil">(tú)</span> }</td>
                    <td>@u.Correo</td>
                    <td>@Etiquetas.TextoRol(u.Rol)</td>
                    <td>@(u.Activo ? "Activo" : "Desactivado")</td>
                    <td class="acciones">
                        <a asp-action="Editar" asp-route-id="@u.Id" class="boton boton-claro boton-chico">Editar</a>
                        @if (u.Id != miId)
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@u.Id" method="post">
                                <input type="hidden" name="activo" value="@(u.Activo ? "false" : "true")" />
                                <button type="submit" class="boton boton-chico @(u.Activo ? "boton-peligro" : "")">
                                    @(u.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
