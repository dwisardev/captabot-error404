@model IReadOnlyList<Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var miId = User.UsuarioId();
}
<div class="encabezado">
    <div>
        <h1>Usuarios del panel</h1>
        <p class="sutil">@Model.Count personas con acceso · solo los administradores ven esta sección</p>
    </div>
    <a asp-action="Nuevo" class="boton"><svg class="ico" aria-hidden="true"><use href="#i-mas" /></svg>Nuevo usuario</a>
</div>

<div class="tabla-contenedor tarjeta">
    <table class="tabla tabla-apilada">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr class="@(u.Activo ? "" : "inactivo")">
                    <td class="celda-principal">
                        <div class="persona">
                            <span class="avatar @Presentacion.ClaseAvatar(u.Id)" aria-hidden="true">@Presentacion.Iniciales(u.Nombre)</span>
                            <div class="persona-datos"><strong>@Presentacion.Nombre(u.Nombre) @if (u.Id == miId) { <span class="sutil">(tú)</span> }</strong></div>
                        </div>
                    </td>
                    <td data-etiqueta="Correo">@u.Correo</td>
                    <td data-etiqueta="Rol"><span class="chip @(u.Rol == "ADMINISTRADOR" ? "chip-admin" : "chip-vendedor")">@Etiquetas.TextoRol(u.Rol)</span></td>
                    <td data-etiqueta="Estado"><span class="chip @(u.Activo ? "chip-activo" : "chip-inactivo")">@(u.Activo ? "Activo" : "Desactivado")</span></td>
                    <td class="acciones"><div class="acciones-fila">
                        <a asp-action="Editar" asp-route-id="@u.Id" class="boton boton-claro boton-chico">Editar</a>
                        @if (u.Id != miId)
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@u.Id" method="post">
                                <input type="hidden" name="activo" value="@(u.Activo ? "false" : "true")" />
                                <button type="submit" class="boton boton-chico @(u.Activo ? "boton-peligro" : "")">
                                    @(u.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        }
                    </div></td>
                </tr>
            }
        </tbody>
    </table>
</div>
