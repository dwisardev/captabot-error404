# Copien este archivo como .env (en la misma carpeta) y completen los valores.
# Docker Compose lo lee solo. El archivo .env no se sube a GitHub.

# Clave que pide la API al panel (opcional en local)
CAPTABOT_API_KEY=

# Azure AI Language – custom question answering (plan gratuito F0). Ver asistente/README.md
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_PROYECTO=captabot-faq

# Canal de Telegram (opcional): token que entrega @BotFather. Ver asistente/README.md
TELEGRAM_BOT_TOKEN=
