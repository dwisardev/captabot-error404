@model ProspectosViewModel
@{
    ViewData["Title"] = "Prospectos";
    var f = Model.Filtro;
    string? Iso(DateOnly? fecha) => fecha?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var lista = Model.Resultado.Contenido;
    var variasPaginas = Model.Resultado.TotalPaginas > 1;
    var alcance = variasPaginas ? "en esta página" : "en la lista";
}
<div class="encabezado">
    <div>
        <h1>Prospectos</h1>
        <p class="sutil">@Model.Resultado.TotalElementos registrados · los calientes aparecen primero</p>
    </div>
</div>

<div class="indicadores">
    <div class="tarjeta indicador ind-total">
        <span class="indicador-icono"><svg class="ico" aria-hidden="true"><use href="#i-usuarios" /></svg></span>
        <span><span class="indicador-valor">@Model.Resultado.TotalElementos</span><span class="indicador-texto">Prospectos@(f.TieneFiltros ? " con estos filtros" : "")</span></span>
    </div>
    <div class="tarjeta indicador ind-caliente">
        <span class="indicador-icono"><svg class="ico" aria-hidden="true"><use href="#i-llama" /></svg></span>
        <span><span class="indicador-valor">@lista.Count(p => p.Calificacion == "CALIENTE")</span><span class="indicador-texto">Calientes @alcance</span></span>
    </div>
    <div class="tarjeta indicador ind-tibio">
        <span class="indicador-icono"><svg class="ico" aria-hidden="true"><use href="#i-chispa" /></svg></span>
        <span><span class="indicador-valor">@lista.Count(p => p.Etapa == "NUEVO")</span><span class="indicador-texto">Por contactar @alcance</span></span>
    </div>
    <div class="tarjeta indicador ind-ganado">
        <span class="indicador-icono"><svg class="ico" aria-hidden="true"><use href="#i-trofeo" /></svg></span>
        <span><span class="indicador-valor">@lista.Count(p => p.Etapa == "CERRADO_GANADO")</span><span class="indicador-texto">Ganados @alcance</span></span>
    </div>
</div>

<form method="get" asp-action="Index" class="filtros tarjeta">
    <div>
        <label for="calificacion">Calificación</label>
        <select id="calificacion" name="calificacion">
            <option value="">Todas</option>
            @HtmlAyuda.Opciones(Etiquetas.Calificaciones, f.Calificacion)
        </select>
    </div>
    <div>
        <label for="etapa">Etapa</label>
        <select id="etapa" name="etapa">
            <option value="">Todas</option>
            @HtmlAyuda.Opciones(Etiquetas.Etapas, f.Etapa)
        </select>
    </div>
    <div>
        <label for="desde">Desde</label>
        <input id="desde" name="desde" type="date" value="@Iso(f.Desde)" />
    </div>
    <div>
        <label for="hasta">Hasta</label>
        <input id="hasta" name="hasta" type="date" value="@Iso(f.Hasta)" />
    </div>
    <div class="acciones-filtro">
        <button type="submit" class="boton"><svg class="ico" aria-hidden="true"><use href="#i-filtro" /></svg>Filtrar</button>
        @if (f.TieneFiltros)
        {
            <a asp-action="Index" class="boton boton-claro">Limpiar</a>
        }
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="aviso aviso-error"></div>

@if (lista.Count == 0)
{
    <section class="tarjeta vacio">
        <div class="vacio-icono"><svg class="ico" aria-hidden="true"><use href="#i-bandeja" /></svg></div>
        <strong>No hay prospectos con estos filtros</strong>
        <p>Prueba con otras fechas o quita los filtros para ver todos los registros.</p>
        @if (f.TieneFiltros)
        {
            <p style="margin-top: 1rem"><a asp-action="Index" class="boton boton-claro">Limpiar filtros</a></p>
        }
    </section>
}
else
{
    <div class="tabla-contenedor tarjeta">
        <table class="tabla tabla-apilada">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Servicio</th>
                    <th>Calificación</th>
                    <th>Etapa</th>
                    <th>Registrado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in lista)
                {
                    <tr>
                        <td class="celda-principal">
                            <div class="persona">
                                <span class="avatar @Presentacion.ClaseAvatar(p.Id)" aria-hidden="true">@Presentacion.Iniciales(p.Nombre)</span>
                                <div class="persona-datos">
                                    <a asp-action="Detalle" asp-route-id="@p.Id" class="enlace-fuerte">@Presentacion.Nombre(p.Nombre)</a>
                                    <span class="chip chip-canal" style="width: fit-content; margin-top: .2rem">
                                        <svg class="ico" aria-hidden="true"><use href="@(p.Canal == "TELEGRAM" ? "#i-enviar" : "#i-globo")" /></svg>@Etiquetas.TextoCanal(p.Canal)
                                    </span>
                                </div>
                            </div>
                        </td>
                        <td data-etiqueta="Teléfono"><a href="tel:@p.Telefono" class="telefono">@p.Telefono</a></td>
                        <td data-etiqueta="Servicio">@p.ServicioInteres</td>
                        <td data-etiqueta="Calificación"><span class="@Etiquetas.ClaseCalificacion(p.Calificacion)">@Etiquetas.TextoCalificacion(p.Calificacion) · @p.Puntaje</span></td>
                        <td data-etiqueta="Etapa"><span class="@Etiquetas.ClaseEtapa(p.Etapa)">@Etiquetas.TextoEtapa(p.Etapa)</span></td>
                        <td data-etiqueta="Registrado">@Etiquetas.FechaHora(p.CreadoEn)</td>
                        <td class="celda-accion"><a asp-action="Detalle" asp-route-id="@p.Id" class="boton boton-claro boton-chico">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Resultado.TotalPaginas > 1)
    {
        <nav class="paginacion" aria-label="Páginas">
            @if (Model.HayAnterior)
            {
                <a class="boton boton-claro" asp-action="Index"
                   asp-route-calificacion="@f.Calificacion" asp-route-etapa="@f.Etapa"
                   asp-route-desde="@Iso(f.Desde)" asp-route-hasta="@Iso(f.Hasta)"
                   asp-route-pagina="@(Model.PaginaActual - 1)">← Anterior</a>
            }
            <span>Página @Model.PaginaActual de @Model.Resultado.TotalPaginas</span>
            @if (Model.HaySiguiente)
            {
                <a class="boton boton-claro" asp-action="Index"
                   asp-route-calificacion="@f.Calificacion" asp-route-etapa="@f.Etapa"
                   asp-route-desde="@Iso(f.Desde)" asp-route-hasta="@Iso(f.Hasta)"
                   asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente →</a>
            }
        </nav>
    }
}
